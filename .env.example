# Environment Variables — copy to .env.local for local development
# Vite requires the VITE_ prefix for variables exposed to the browser.

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8080

# Public R2 CDN base URL for images (no trailing slash). Leave empty to serve from public/.
VITE_CDN_URL=

# Node environment (set automatically by Vite, listed here for reference)
# NODE_ENV=development

# Google Maps Embed API key (free) for the login-location map in Account
# Settings. Restrict it to your site's referrers. Empty shows a link instead.
VITE_GOOGLE_MAPS_EMBED_KEY=
