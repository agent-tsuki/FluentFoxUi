  "readingTips": {
    "会": "あ(う) \"meet\" in everyday Japanese; カイ in compounds like 会社 and 会話.",
    "明": "あか(るい) \"bright\"; メイ in compounds; あ(ける) in 明日 (あした is a special reading).",
    "方": "かた \"person / way of doing\" (話し方); ホウ \"direction\" (この方 can be either).",
    "着": "き(る) \"wear\"; つ(く) \"arrive\"; チャク in 到着.",
    "開": "あ(ける)/あ(く) \"open\"; ひら(く) is a more formal \"open\"; カイ in compounds.",
    "楽": "たの(しい) \"fun\"; ラク \"comfortable\"; ガク \"music\" (音楽).",
    "重": "おも(い) \"heavy\"; ジュウ in 体重; え in 二重 (ふたえ, double eyelid).",
    "風": "かぜ \"wind\"; フウ in 台風; ふう \"style\" as in 和風."
  },
